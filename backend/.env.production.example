# ============================================================
# RealtyHub backend — PRODUCTION environment template
# Copy to backend/.env on the server and fill in real values.
# NEVER commit the filled-in .env (it is gitignored).
# ============================================================

# --- Required: Flask / auth secrets ---
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_HEX
JWT_SECRET_KEY=CHANGE_ME_64_HEX

# --- Required: marks production behaviour (secure cookies) ---
FLASK_ENV=production

# --- Required: PostgreSQL (cPanel prefixes DB/user with your account name) ---
# Password special chars must be URL-encoded (e.g. @ -> %40).
# HostyCare shared: Postgres listens on 127.0.0.200 (NOT localhost, which
# resolves to ::1 and is rejected by pg_hba.conf).
DATABASE_URL=postgresql+psycopg2://CPUSER_DBUSER:DB_PASSWORD@127.0.0.200:5432/CPUSER_DBNAME

# --- Tune per host (HostyCare shared: keep SMALL; slots are limited) ---
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1

# --- Required: browser origins allowed to call the API ---
CORS_ORIGINS=https://plotandroof.com,https://www.plotandroof.com,https://api.plotandroof.com
FRONTEND_URL=https://plotandroof.com

# --- Shared secret for cron callbacks (X-Cron-Key header) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_KEY=CHANGE_ME

# --- Email (Gmail SMTP). Set MAIL_ENABLED=true once credentials are filled. ---
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=

# --- Storage: local disk (default) or Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=realtyhub-images

# --- Rate limiting ---
# Default in-process memory://. Do NOT use db:// on shared cPanel: every
# counter hit draws a Postgres connection and exhausts the few available
# connection slots ("remaining connection slots are reserved..."). Use db://
# only when the DB has real connection headroom.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per minute

# --- Lead SLA (minutes) ---
LEAD_SLA_MINUTES=15

# --- Uploads: absolute path, outside the repo is fine; default below ---
# UPLOAD_FOLDER=/home/CPUSER/realtyhub/backend/uploads
