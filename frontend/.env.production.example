# Backend API URL. Use a relative "/api" so the browser talks to the frontend
# origin and Next.js proxies to the API (see next.config.js rewrites). This
# keeps admin/owner session cookies + CSRF same-origin and avoids CORS.
NEXT_PUBLIC_API_BASE_URL=/api

# Absolute backend origin. Used server-side (SSR fetches, next.config rewrite
# destination) and for uploaded-media URLs, which are served directly.
NEXT_PUBLIC_BACKEND_URL=https://api.plotandroof.com

# Public site URL (canonical links + social share previews)
NEXT_PUBLIC_SITE_URL=https://plotandroof.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
